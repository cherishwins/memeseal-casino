# ==============================================
# MemeSeal Casino - Environment Variables
# ==============================================
# Copy this file to .env to override defaults.
# The app works out of the box with no .env file.

# ---------------------------------------------
# DEMO MODE (default: true)
# ---------------------------------------------
# When true, the app runs fully client-side:
#  - chips stored in localStorage
#  - chip purchases instant (no backend / no Stars)
#  - lottery pot grows locally
# Flip to false to wire up your own backend.
VITE_DEMO_MODE=true

# Starting chip balance for new demo players.
VITE_STARTING_CHIPS=500

# ---------------------------------------------
# BRANDING (override to white-label)
# ---------------------------------------------
VITE_BRAND_NAME=MEMESEAL
VITE_BRAND_TAGLINE=CASINO
VITE_BRAND_FOOTER=POWERED BY MEMESEAL x TON

# ---------------------------------------------
# BACKEND (only needed when VITE_DEMO_MODE=false)
# ---------------------------------------------
# Your API base URL. The app expects these endpoints:
#  GET  /api/v1/casino/balance/:userId   -> { success, chips }
#  POST /api/v1/casino/buy-chips         -> { success, invoice_url }
#  POST /api/v1/casino/play              -> { success, chips, error? }
#  GET  /api/v1/lottery/pot              -> { pot_stars }
# VITE_API_URL=https://your-backend.example.com
